# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Output
/.next/
/out/
/build
*.tsbuildinfo

# Next.js App Router generated types
next-env.d.ts

# Environment variables (Aman dari kebocoran API Key/Secrets)
.env
.env*.local
.env.development
.env.production
!.env.example

# Testing & Coverage
/coverage

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & IDE Files
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/

# Vercel & Turbopack Cache
.vercel
.turbo